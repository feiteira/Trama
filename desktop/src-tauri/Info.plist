<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Merged into the app's Info.plist by Tauri. Recording a call asks for the microphone and
       for the computer's sound (Core Audio process tap); the reasons are translated in
       macos/<lang>.lproj/InfoPlist.strings. -->
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>pt</string>
    <string>es</string>
  </array>
  <key>NSMicrophoneUsageDescription</key>
  <string>Trama records your side of a call you choose to record, on this computer. Nothing is sent anywhere.</string>
  <key>NSAudioCaptureUsageDescription</key>
  <string>Trama records the other side of a call you choose to record, from what this computer plays. Nothing is sent anywhere.</string>
</dict>
</plist>
